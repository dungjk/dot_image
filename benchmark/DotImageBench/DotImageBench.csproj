<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AnalysisLevel>latest</AnalysisLevel>
    <LangVersion>latest</LangVersion>
    <WarningsAsErrors>$(WarningsAsErrors);NU1605;CA1416</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/DotImage/DotImage.csproj" />
    <ProjectReference Include="../../src/DotImage.Extended/DotImage.Extended.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="NetVips" />
    <PackageReference Include="SixLabors.ImageSharp" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../samples/DotImage.Samples/images/sample_640×426.jpeg" Link="images/sample_640×426.jpeg" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../samples/DotImage.Samples/images/sample_640×426.png" Link="images/sample_640×426.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>