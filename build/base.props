<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <Company>dungjk</Company>
        <Authors>dungjk</Authors>
        <Copyright>Copyright © dungjk 2026</Copyright>
        <Product>DotImage</Product>
        <PackageProjectUrl>https://github.com/dungjk/dot_image</PackageProjectUrl>
    </PropertyGroup>
    <PropertyGroup>
        <AnalysisLevel>latest</AnalysisLevel>
        <LangVersion>latest</LangVersion>
        <WarningsAsErrors>$(WarningsAsErrors);NU1605;CA1416</WarningsAsErrors>
    </PropertyGroup>
</Project>